        "query": "from(bucket: \"patient_data\")\n  |> range(start: 0) // Look at all historical data\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vitals\")\n  // Added this line to prevent data type collisions!\n  |> filter(fn: (r) => r[\"_field\"] == \"confidence\") \n  |> group() // Group all records together\n  // Find the minimum (first) and maximum (last) timestamps\n  |> reduce(\n      fn: (r, accumulator) => ({\n        minTime: if accumulator.minTime == 0 then int(v: r._time) else if int(v: r._time) < accumulator.minTime then int(v: r._time) else accumulator.minTime,\n        maxTime: if int(v: r._time) > accumulator.maxTime then int(v: r._time) else accumulator.maxTime\n      }),\n      identity: {minTime: 0, maxTime: 0}\n    )\n  // Calculate the duration in seconds\n  |> map(fn: (r) => ({\n      duration_seconds: (r.maxTime - r.minTime) / 1000000000 // Convert nanoseconds to seconds\n    }))",
