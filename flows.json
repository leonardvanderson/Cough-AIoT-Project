    {
        "id": "2f4fb31bab8bde17",
        "type": "function",
        "z": "64ab3de8b366f712",
        "name": "Check Room Environment",
        "func": "let rTemp = Number(msg.payload.room_temp_c || 25.0);\nlet hum = Number(msg.payload.humidity_pct || 50.0);\n\nif (hum >= 70) {\n    msg.payload = `⚠️ <b>Udara Terlalu Lembap</b> (${hum}% | ${rTemp}°C). Memicu bersin/jamur! <a href=\"https://www.tokopedia.com/find/dehumidifier\" target=\"_blank\" style=\"color: #007bff; text-decoration: underline;\">Nyalakan Dehumidifier/AC</a>`;\n} else if (hum <= 40) {\n    msg.payload = `⚠️ <b>Udara Terlalu Kering</b> (${hum}% | ${rTemp}°C). Memicu batuk kering! <a href=\"https://www.tokopedia.com/find/humidifier\" target=\"_blank\" style=\"color: #007bff; text-decoration: underline;\">Nyalakan Humidifier</a>`;\n} else if (rTemp < 20) {\n    msg.payload = `🥶 <b>Kamar Terlalu Dingin</b> (${rTemp}°C | ${hum}%). Naikkan suhu AC ruangan.`;\n} else {\n    msg.payload = `✅ Kamar Ideal (${rTemp}°C | Kelembapan: ${hum}%)`;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 240,
        "wires": [
            [
                "8979454bb12b7668"
            ]
        ]
