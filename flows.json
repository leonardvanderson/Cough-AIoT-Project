    {
        "id": "1b8438e3b963117f",
        "type": "function",
        "z": "cea766101cfe7747",
        "name": "Check Symptom And Display",
        "func": "const COUGH_LIMIT = 5;\nconst SNEEZE_LIMIT = 5;\nlet coughCount = 0;\nlet sneezeCount = 0;\n\n// Count today's history from the InfluxDB query\nfor (let i = 0; i < msg.payload.length; i++) {\n    if (msg.payload[i].symptom === 'cough') coughCount = msg.payload[i]._value;\n    if (msg.payload[i].symptom === 'sneeze') sneezeCount = msg.payload[i]._value;\n}\n\nlet activeAlerts = [];\n\n// Evaluate Cough Status\nif (coughCount >= COUGH_LIMIT) {\n    activeAlerts.push(`⚠️ <b>In-sick Cough</b> (${coughCount}x batuk hari ini). <a href='https://www.halodoc.com/obat-dan-vitamin' target='_blank'>💊 Beli Obat Batuk</a>`);\n} else if (coughCount > 0) {\n    activeAlerts.push(`🤧 <b>Occurrence Cough</b> (${coughCount}/${COUGH_LIMIT} menuju batas sakit).`);\n}\n\n// Evaluate Sneeze Status\nif (sneezeCount >= SNEEZE_LIMIT) {\n    activeAlerts.push(`⚠️ <b>In-sick Sneeze</b> (${sneezeCount}x bersin hari ini). <a href='https://www.halodoc.com/obat-dan-vitamin' target='_blank'>💊 Beli Obat Flu</a>`);\n} else if (sneezeCount > 0) {\n    activeAlerts.push(`🤧 <b>Occurrence Sneeze</b> (${sneezeCount}/${SNEEZE_LIMIT} menuju batas sakit).`);\n}\n\n// Format Output\nif (activeAlerts.length === 0) {\n    msg.payload = \"✅ Not-sick: Tidak ada gejala pernapasan.\";\n} else {\n    // Join multiple alerts with a line break so they stack neatly\n    msg.payload = activeAlerts.join(\"<br><br>\"); \n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 420,
        "wires": [
            [
                "3bf7a82be2a03ca9"
            ]
        ]
    },
