    {
        "id": "f66c75fa1c0d9c54",
        "type": "function",
        "z": "64ab3de8b366f712",
        "name": "Insert payload and time",
        "func": "let safeTemp = Number(msg.payload.temperature_c);\nlet safeRoomTemp = Number(msg.payload.room_temp_c || 25.0);\nlet safeHum = Number(msg.payload.humidity_pct || 50.0);\nlet safeConf = Number(msg.payload.confidence);\nlet safeSymptom = msg.payload.symptom || \"unknown\";\n\n// Format for InfluxDB: [ {fields}, {tags} ]\nmsg.payload = [{\n    temperature: safeTemp,\n    room_temperature: safeRoomTemp,\n    humidity: safeHum,\n    confidence: safeConf\n},\n{\n    symptom: safeSymptom\n}];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
