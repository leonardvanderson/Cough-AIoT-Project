    {
        "id": "a5101e779a985d92",
        "type": "function",
        "z": "cea766101cfe7747",
        "name": "Format Data for Chart",
        "func": "let messages = [];\n\nfor (let i = 0; i < msg.payload.length; i++) {\n    let row = msg.payload[i];\n    // InfluxDB returns the time as an ISO string in row.day\n    let dateObj = new Date(row.day);\n    \n    messages.push({\n        payload: row._value,           \n        topic: row.symptom,           \n        timestamp: dateObj.toLocaleDateString()    \n    });\n}\n\n// Sort chronologically\nmessages.sort((a, b) => new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime());\n\nreturn [messages];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 720,
        "y": 920,
        "wires": [
